# PathWise behind Caddy (W08, W14, P-47, P-56): the landing page at /, the web app at /app/ and the API at /api/ on one
# origin, with automatic HTTPS. Used by the web image (compose.web.yaml) and by a Caddy installed on the host (docs/DEPLOYMENT.md §8).
#   PATHWISE_DOMAIN    site address, e.g. pathwise.example.com (localhost for a local test)
#   PATHWISE_UPSTREAM  the app: app:8080 in compose (default), 127.0.0.1:8080 for a Caddy on the host
#   PATHWISE_WEB_ROOT  directory holding app/ (the web build) and the landing page (landing/ of the repo): /srv in the
#                      image
#   PATHWISE_APK_URL   link of the driver app's APK on the landing page; empty (default): the page has no download button
#   PATHWISE_TRUSTED_PROXIES  proxies in front of Caddy whose client IP header is believed, space separated CIDRs:
#                      the Cloudflare ranges when the domain is proxied by Cloudflare (docs/DEPLOYMENT.md §8.3). Empty
#                      (default): no proxy, the peer of Caddy is the client.
#   PATHWISE_ACCESS_LOG  file of the access log (F-88): /var/log/caddy/access.log (default)
# Caddy sends the app one X-Forwarded-For, the client IP it worked out (F-59): CF-Connecting-IP or X-Forwarded-For of a
# trusted proxy, otherwise the peer address, so a client cannot choose it. The app trusts it from private addresses only.

{
	servers {
		trusted_proxies static {$PATHWISE_TRUSTED_PROXIES:}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
		trusted_proxies_strict
	}
}

{$PATHWISE_DOMAIN} {
	encode zstd gzip

	# Access log (F-88): one JSON line per request, client_ip is the user's IP (trusted_proxies above). A file, so it
	# outlives the container (volume caddy-logs in compose.web.yaml; /var/log/caddy of a Caddy on the host) and CrowdSec
	# can read it. Rolled at 20 MiB, gzipped, at most 10 files and 90 days. Caddy already hides Cookie, Set-Cookie and
	# Authorization; the invitation code and the reset-link token travel in URLs (and in Referer of the pages after them),
	# so they are replaced by REDACTED.
	log {
		output file {$PATHWISE_ACCESS_LOG:/var/log/caddy/access.log} {
			roll_size 20MiB
			roll_keep 10
			roll_keep_for 2160h
		}
		format filter {
			wrap json
			fields {
				request>uri multi_regexp {
					regexp "^(/api/v1/invitations/)[A-Za-z0-9_-]{20,}" "${1}REDACTED"
					regexp "([?&](?:code|token)=)[^&#]*" "${1}REDACTED"
				}
				request>headers>Referer multi_regexp {
					regexp "(/api/v1/invitations/)[A-Za-z0-9_-]{20,}" "${1}REDACTED"
					regexp "([?&](?:code|token)=)[^&#]*" "${1}REDACTED"
				}
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# The API, Swagger on staging (prod answers 404 itself), and the overall health for an external uptime check (T54):
	# {"status":"UP"} or 503, no details. The rest of Actuator is not exposed.
	@backend path /api/* /swagger-ui* /v3/api-docs* /actuator/health
	handle @backend {
		reverse_proxy {$PATHWISE_UPSTREAM:app:8080} {
			header_up X-Forwarded-For {client_ip}
		}
	}

	redir /app /app/ 308

	handle /app/* {
		root * {$PATHWISE_WEB_ROOT:/srv}
		# The web app is behind a sign-in: keep it out of search results (the landing page is what should show).
		header X-Robots-Tag "noindex"
		# Hashed file names never change: cache for a year. index.html, config.js and icons: revalidate.
		@hashed path /app/assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path /app/assets/*
		header @unhashed Cache-Control "no-cache"
		# Routes of the web app fall back to index.html; a missing asset stays 404.
		@route {
			not path /app/assets/*
			not file
		}
		rewrite @route /app/index.html
		file_server
	}

	# Icons browsers ask for at the root are the web app's.
	@rootIcon path /favicon.ico /apple-touch-icon.png
	handle @rootIcon {
		root * {$PATHWISE_WEB_ROOT:/srv}
		rewrite * /app{path}
		header Cache-Control "no-cache"
		file_server
	}

	# The landing page (W14, P-47): only its own files, so nothing else under the web root (a Caddyfile next to app/ on
	# a host) is ever served. The page gets the APK link from the environment (templates).
	@landing path / /index.html /robots.txt /sitemap.xml /og.png /web/* /mweb/* /phone/* /img/*
	handle @landing {
		root * {$PATHWISE_WEB_ROOT:/srv}
		@page path / /index.html
		templates @page
		header Cache-Control "no-cache"
		file_server
	}

	# Anything else (and a missing file of the landing): a real 404 with the landing's own page, so search engines do not
	# see a page that answers 200 (a soft 404). Addresses under /app/ keep the web app's own "Không tìm thấy trang".
	handle {
		error 404
	}
	handle_errors 404 {
		root * {$PATHWISE_WEB_ROOT:/srv}
		rewrite * /404.html
		header Cache-Control "no-cache"
		file_server
	}
}
