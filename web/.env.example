# Copy to .env.local for local overrides. Never commit real keys.
# A deployment overrides these at runtime with /app/config.js (W08, P-56; docs/DEPLOYMENT.md §8), so images carry no key.
# Origin of the API; empty means the same origin as the web app (P-47). Dev uses the Vite proxy, so keep it empty.
VITE_API_ORIGIN=
# Map tiles (P-45, task W04): maptiler | osm (osm only for development).
VITE_BASEMAP=maptiler
VITE_MAPTILER_KEY=
