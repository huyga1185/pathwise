# Copy to .env (git-ignored) and adjust. Used by compose.yaml.
# Every value here is a local-dev placeholder, never a real secret.

# --- Infrastructure (host ports avoid native MariaDB 3306 / Redis 6379)
MARIADB_ROOT_PASSWORD=pathwise-dev
MARIADB_DATABASE=pathwise
MARIADB_PORT=3307
REDIS_PORT=6380
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
APP_PORT=8080

# --- Application (only used by the "app" profile; Spring relaxed binding)
SPRING_PROFILES_ACTIVE=dev
# Base64, at least 256 bits. Dev-only all-zero key; generate a real one with: openssl rand -base64 32
TOKEN_JWT_ACCESS_TOKEN_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
MAIL_OTP_SENDER_ADDRESS=no-reply@pathwise.local
MAIL_OTP_SENDER_NAME=PathWise
SERVICE_IDENTITY_APP_URL=http://localhost:8080
SERVICE_IDENTITY_APP_NAME=PathWise
SERVICE_IDENTITY_COMPANY_NAME=PathWise
SERVICE_IDENTITY_COMPANY_URL=http://localhost:8080
SERVICE_IDENTITY_COMPANY_ADDRESS=Local dev
