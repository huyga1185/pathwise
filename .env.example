# Copy to .env (git-ignored) and adjust. Used by compose.yaml (T05).

# --- Infrastructure (host ports avoid native MariaDB 3306 / Redis 6379)
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=pathwise
MARIADB_PORT=3307
REDIS_PORT=6380
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
APP_PORT=8080

# --- Application (only used by the "app" profile; Spring relaxed binding)
SPRING_PROFILES_ACTIVE=
# Base64, at least 256 bits. Generate with: openssl rand -base64 32
TOKEN_JWT_ACCESSTOKENSECRET=change-me
MAIL_OTP_SENDER_ADDRESS=no-reply@pathwise.local
MAIL_OTP_SENDER_NAME=PathWise
SERVICE_IDENTITY_APPURL=http://localhost:8080
SERVICE_IDENTITY_APPNAME=PathWise
SERVICE_IDENTITY_COMPANYNAME=PathWise
SERVICE_IDENTITY_COMPANYURL=http://localhost:8080
SERVICE_IDENTITY_COMPANYADDRESS=
