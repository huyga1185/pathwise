# Copy to .env (git-ignored) and adjust. Used by compose.yaml.
# Every value here is a local-dev placeholder, never a real secret.

# --- Infrastructure (host ports avoid native MariaDB 3306 / Redis 6379)
MARIADB_ROOT_PASSWORD=pathwise-dev
MARIADB_DATABASE=pathwise
MARIADB_PORT=3307
REDIS_PORT=6380
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
APP_PORT=8080

# --- Application (only used by the "app" profile; Spring relaxed binding)
SPRING_PROFILES_ACTIVE=dev
# Base64, at least 256 bits. Dev-only all-zero key; generate a real one with: openssl rand -base64 32
TOKEN_JWT_ACCESS_TOKEN_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
MAIL_OTP_SENDER_ADDRESS=no-reply@pathwise.local
MAIL_OTP_SENDER_NAME=PathWise
SERVICE_IDENTITY_APP_URL=http://localhost:8080
SERVICE_IDENTITY_APP_NAME=PathWise
SERVICE_IDENTITY_COMPANY_NAME=PathWise
SERVICE_IDENTITY_COMPANY_URL=http://localhost:8080
SERVICE_IDENTITY_COMPANY_ADDRESS=Local dev

# --- Browser origins allowed to call the API (comma separated); empty = none (ARCHITECTURE.md §6.4)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Self-hosted routing for dev (optional): docker compose -f compose.yaml -f compose.routing.yaml up -d
# These reach the app in a container (profile app). App from the IDE: set routing.matrix.osrm.base-url
# http://localhost:5000 and routing.geocoding.nominatim.base-url http://localhost:8088 in application-dev.yaml.
# ROUTING_MATRIX_OSRM_BASEURL=http://osrm:5000
# ROUTING_MATRIX_OSRM_MAXTABLESIZE=200
# ROUTING_GEOCODING_NOMINATIM_BASEURL=http://nominatim:8080
# ROUTING_GEOCODING_NOMINATIM_RATELIMIT_ENABLED=false
# Area of the map data (minlon,minlat,maxlon,maxlat); default Da Nang with Hoi An, "none" = whole Vietnam (> 11 GB RAM).
# ROUTING_BBOX=107.80,15.80,108.40,16.25
