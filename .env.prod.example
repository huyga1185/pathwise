# Copy to .env next to compose.prod.yaml on the VPS (never commit it). See docs/DEPLOYMENT.md.
# Every value below is a placeholder: replace all "change-me" values.

# --- Image (ghcr.io/huyga1185/pathwise). staging: develop or develop-<sha>; prod: x.y.z
APP_IMAGE_TAG=0.1.0
SPRING_PROFILES_ACTIVE=prod
APP_PORT=8080

# --- Database (container only, never published to the host)
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=pathwise
MARIADB_USER=pathwise
MARIADB_PASSWORD=change-me

# --- Secrets. Base64, at least 256 bits: openssl rand -base64 32
TOKEN_JWT_ACCESS_TOKEN_SECRET=change-me

# --- SMTP (real provider, e.g. Brevo)
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=change-me
SPRING_MAIL_PASSWORD=change-me
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_OTP_SENDER_ADDRESS=no-reply@example.com
MAIL_OTP_SENDER_NAME=PathWise

# --- Identity shown in emails
SERVICE_IDENTITY_APP_URL=https://pathwise.example.com
SERVICE_IDENTITY_APP_NAME=PathWise
SERVICE_IDENTITY_COMPANY_NAME=PathWise
SERVICE_IDENTITY_COMPANY_URL=https://pathwise.example.com
SERVICE_IDENTITY_COMPANY_ADDRESS=change-me

# --- Web dispatcher and HTTPS (Caddy, compose.web.yaml or Caddy on the host; docs/DEPLOYMENT.md §8, P-56)
# Domain pointing at this host; Caddy gets its certificate from Let's Encrypt.
PATHWISE_DOMAIN=pathwise.example.com
# Map tiles of the web app, read at runtime: restrict the key to the domain in MapTiler's dashboard. Empty = no tiles.
MAPTILER_KEY=
# WEB_BASEMAP=maptiler
# WEB_IMAGE=ghcr.io/huyga1185/pathwise-web

# --- Other web origins allowed to call the API (comma separated, exact https origins); empty = none.
# The web app is on the same origin as the API (P-47), so it needs none.
CORS_ALLOWED_ORIGINS=

# --- Routing (self-hosted OSRM and Nominatim, compose.routing.yaml; docs/DEPLOYMENT.md §7, P-55).
# Without these the app uses the public servers (demo only). Same host: http://osrm:5000 and http://nominatim:8080.
# Separate routing host: its private/VPN address, e.g. http://10.0.0.5:5000 and http://10.0.0.5:8088.
# ROUTING_MATRIX_OSRM_BASEURL=http://osrm:5000
# ROUTING_MATRIX_OSRM_MAXTABLESIZE=200
# Turn-by-turn directions (T33) use the same OSRM unless ROUTING_DIRECTIONS_OSRM_BASEURL is set.
# ROUTING_GEOCODING_NOMINATIM_BASEURL=http://nominatim:8080
# ROUTING_GEOCODING_NOMINATIM_RATELIMIT_ENABLED=false

# --- Only on the host that runs compose.routing.yaml
# Area of the map data (minlon,minlat,maxlon,maxlat); default Da Nang with Hoi An. "none" = whole Vietnam, which needs
# more than 11 GB of RAM to prepare OSRM. Points outside the area get no route and no geocoding results.
# ROUTING_BBOX=107.80,15.80,108.40,16.25
# Address the two services are published on: 127.0.0.1 when the app is on the same host, otherwise the routing
# host's private/VPN address (never 0.0.0.0: neither service has authentication).
# ROUTING_BIND=127.0.0.1
# OSRM_PORT=5000
# OSRM_MAX_TABLE_SIZE=200
# NOMINATIM_PORT=8088
# NOMINATIM_DB_PASSWORD=change-me
# NOMINATIM_THREADS=2

# --- Memory limits for a 2 GB host that also runs compose.routing.yaml (docs/DEPLOYMENT.md §7.1). Uncomment there;
# on 4 GB or more leave them unset.
# JAVA_OPTS=-Xmx384m -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=64m
# MARIADB_INNODB_BUFFER_POOL_SIZE=64M
# NOMINATIM_PG_SHARED_BUFFERS=128MB
# NOMINATIM_PG_EFFECTIVE_CACHE_SIZE=512MB
# OSRM_THREADS=1
# NOMINATIM_THREADS=1
